{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm -w run typecheck:libs && pnpm --filter @workspace/memory-trainer run build",
  "outputDirectory": "artifacts/memory-trainer/dist/public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
